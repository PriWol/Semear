    {
      "titulo": "Conferir juntos",
      "minutos": 5,
      "texto": "Abram as caixas e leiam o nome de cada carta em voz alta, com o som inicial alongado."
    },
    {
      "titulo": "Folha: ligue ao som",
      "minutos": 5,
      "texto": "Leia as figuras e deixe a criança ligar ao som."
